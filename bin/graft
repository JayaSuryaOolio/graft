#!/usr/bin/env zsh
#
# graft — mirror a git worktree into its repo's root checkout in the
# background, so path-bound tools (Spotlight, Finder, anything hardcoded to
# a fixed directory) always see whichever worktree is "in focus".
#
# Usage:
#   graft start            Mirror the current worktree into its root repo
#   graft stop [root]      Stop mirroring (defaults to the current repo)
#   graft list             List all running graft instances

emulate -L zsh
setopt pipefail

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/graft"
STATE_FILE="$STATE_DIR/state.map"
LOG_DIR="$STATE_DIR/logs"

typeset -gA GRAFT_MAP

_graft_load_map() {
  GRAFT_MAP=()
  [[ -f "$STATE_FILE" ]] || return 0
  local root worktree pid
  while IFS=$'\t' read -r root worktree pid; do
    [[ -z "$root" ]] && continue
    GRAFT_MAP[$root]="$worktree|$pid"
  done < "$STATE_FILE"
}

_graft_save_map() {
  mkdir -p "$STATE_DIR"
  : > "$STATE_FILE"
  local root entry worktree pid
  for root entry in "${(@kv)GRAFT_MAP}"; do
    worktree="${entry%%|*}"
    pid="${entry##*|}"
    printf '%s\t%s\t%s\n' "$root" "$worktree" "$pid" >> "$STATE_FILE"
  done
}

_graft_prune_dead() {
  local changed=0
  local root entry pid
  for root entry in "${(@kv)GRAFT_MAP}"; do
    pid="${entry##*|}"
    if ! kill -0 "$pid" 2>/dev/null; then
      unset "GRAFT_MAP[$root]"
      changed=1
    fi
  done
  (( changed )) && _graft_save_map
}

_graft_resolve() {
  # Prints "$worktree\t$root" for the repo containing $PWD (or $1).
  local dir="${1:-$PWD}"
  local worktree common_dir root
  worktree=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || return 1
  common_dir=$(cd "$worktree" && git rev-parse --git-common-dir)
  [[ "$common_dir" = /* ]] || common_dir="$worktree/$common_dir"
  root=$(cd "$(dirname "$common_dir")" && pwd)
  printf '%s\t%s\n' "$worktree" "$root"
}

_graft_sync() {
  local worktree="$1" root="$2"
  rsync -a --delete --exclude='.git' --filter=':- .gitignore' "$worktree/" "$root/"
}

_graft_require() {
  local missing=0
  local name
  for name in "$@"; do
    if ! command -v "$name" >/dev/null 2>&1; then
      echo "graft: '$name' is required but not installed." >&2
      echo "  Re-run this repo's install.sh, or install it manually:" >&2
      echo "    macOS:          brew install $name" >&2
      echo "    Debian/Ubuntu:  sudo apt-get install $name" >&2
      echo "    Fedora/RHEL:    sudo dnf install $name" >&2
      echo "    Arch:           sudo pacman -S $name" >&2
      missing=1
    fi
  done
  (( missing )) && return 1
  return 0
}

_graft_stop_root() {
  local root="$1"
  _graft_load_map
  local entry="${GRAFT_MAP[$root]:-}"
  if [[ -z "$entry" ]]; then
    echo "graft: nothing running for $root" >&2
    return 1
  fi
  local pid="${entry##*|}"
  local worktree="${entry%%|*}"

  # Kill the watcher's children first (fswatch/rsync), then the watcher itself.
  pkill -TERM -P "$pid" 2>/dev/null
  kill -TERM "$pid" 2>/dev/null
  sleep 0.3
  pkill -KILL -P "$pid" 2>/dev/null
  kill -KILL "$pid" 2>/dev/null

  git -C "$root" checkout -- . 2>/dev/null
  git -C "$root" clean -fd >/dev/null 2>&1

  local stash_marker="graft-stash-for-$worktree"
  local stash_ref
  stash_ref=$(git -C "$root" stash list --format='%gd %s' | awk -v m="$stash_marker" 'index($0, m) { print $1; exit }')
  if [[ -n "$stash_ref" ]]; then
    if git -C "$root" stash pop "$stash_ref"; then
      echo "graft: restored stashed changes in $root"
    else
      echo "graft: failed to restore stash '$stash_marker' in $root — resolve manually (git stash list)" >&2
    fi
  fi

  unset "GRAFT_MAP[$root]"
  _graft_save_map
  echo "graft stopped for $root"
}

cmd_start() {
  local resolved worktree root
  local stash_root_changes=0
  local arg
  for arg in "$@"; do
    [[ "$arg" == "--stash-root-changes" ]] && stash_root_changes=1
  done

  resolved=$(_graft_resolve) || {
    echo "graft: not inside a git repository" >&2
    return 1
  }
  worktree="${resolved%%$'\t'*}"
  root="${resolved##*$'\t'}"

  if [[ "$worktree" == "$root" ]]; then
    echo "graft: already inside the root repo ($root) — nothing to mirror" >&2
    return 1
  fi

  _graft_require fswatch rsync || return 1

  _graft_load_map
  _graft_prune_dead

  local existing="${GRAFT_MAP[$root]:-}"
  if [[ -n "$existing" ]]; then
    local existing_worktree="${existing%%|*}"
    if [[ "$existing_worktree" == "$worktree" ]]; then
      echo "graft: already running for $worktree"
      echo "$root"
      return 0
    fi
    echo "graft: already running for $root from $existing_worktree" >&2
    echo "  Run 'graft stop $root' first, then start again from here." >&2
    return 1
  fi

  if [[ -n "$(git -C "$root" status --porcelain)" ]]; then
    echo "graft: $root has uncommitted changes." >&2
    if (( ! stash_root_changes )); then
      if [[ ! -t 0 ]]; then
        # No controlling terminal to prompt on (e.g. invoked by a non-
        # interactive caller like worktree-studio) — refuse rather than
        # block forever on a read() that will never get input, or worse,
        # silently treat EOF-on-stdin as an implicit "no". Callers that
        # want the old prompt's "yes" behavior non-interactively should
        # pass --stash-root-changes explicitly.
        echo "graft: refusing to prompt without a terminal — re-run with --stash-root-changes to stash and start non-interactively, or commit/stash the changes in $root yourself first" >&2
        return 1
      fi
      local reply
      read -r "reply?Stash them and start graft? [y/N] "
      if [[ ! "$reply" =~ ^[Yy]$ ]]; then
        echo "graft: aborted — commit or stash the changes in $root first" >&2
        return 1
      fi
    fi
    if ! git -C "$root" stash push --include-untracked --message "graft-stash-for-$worktree" >&2; then
      echo "graft: failed to stash changes in $root" >&2
      return 1
    fi
    echo "graft: stashed uncommitted changes in $root" >&2
  fi

  mkdir -p "$LOG_DIR"
  local logfile="$LOG_DIR/$(basename "$root").log"

  _graft_sync "$worktree" "$root"

  (
    fswatch -o -l 0.5 "$worktree" 2>>"$logfile" | while read -r _; do
      rsync -a --delete --exclude='.git' --filter=':- .gitignore' "$worktree/" "$root/" 2>>"$logfile"
    done
  ) >>"$logfile" 2>&1 &
  disown
  local pid=$!

  GRAFT_MAP[$root]="$worktree|$pid"
  _graft_save_map

  echo "graft running from the worktree $worktree"
  echo "$root"
}

cmd_stop() {
  local root="$1"
  if [[ -z "$root" ]]; then
    local resolved
    resolved=$(_graft_resolve) || {
      echo "graft: not inside a git repository; pass a root path or run 'graft list'" >&2
      return 1
    }
    root="${resolved##*$'\t'}"
  else
    root=$(cd "$root" 2>/dev/null && pwd) || {
      echo "graft: no such directory: $1" >&2
      return 1
    }
  fi
  _graft_stop_root "$root"
}

cmd_list() {
  _graft_load_map
  _graft_prune_dead
  if (( ${#GRAFT_MAP} == 0 )); then
    echo "no graft instances running"
    return 0
  fi
  local root entry worktree pid
  for root entry in "${(@kv)GRAFT_MAP}"; do
    worktree="${entry%%|*}"
    pid="${entry##*|}"
    printf '%s  <-  %s  (pid %s)\n' "$root" "$worktree" "$pid"
  done
}

cmd_help() {
  cat <<'EOF'
graft — mirror a git worktree into its repo's root checkout

Usage:
  graft start            Mirror the current worktree into its root repo
  graft stop [root]      Stop mirroring (defaults to the current repo)
  graft list             List all running graft instances
EOF
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  stop)  shift; cmd_stop "$@" ;;
  list)  shift; cmd_list "$@" ;;
  help|-h|--help|"") cmd_help ;;
  *) echo "graft: unknown command '$1'" >&2; cmd_help; exit 1 ;;
esac
