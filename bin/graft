#!/usr/bin/env zsh
#
# graft — mirror a git worktree into its repo's root checkout in the
# background, so path-bound tools (Spotlight, Finder, anything hardcoded to
# a fixed directory) always see whichever worktree is "in focus".
#
# Usage:
#   graft start            Mirror the current worktree into its root repo
#   graft stop [root]      Stop mirroring (defaults to the current repo)
#   graft list             List all running graft instances

emulate -L zsh
setopt pipefail

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/graft"
STATE_FILE="$STATE_DIR/state.map"
LOG_DIR="$STATE_DIR/logs"

# State: one row per stacked worktree, "root<TAB>worktree<TAB>pid", oldest first.
# The last row for a root is the active mirror; earlier rows are paused (pid "-").
typeset -ga GRAFT_ROWS

_graft_load_map() {
  GRAFT_ROWS=()
  [[ -f "$STATE_FILE" ]] && GRAFT_ROWS=("${(@f)$(<"$STATE_FILE")}")
  GRAFT_ROWS=("${(@)GRAFT_ROWS:#}")
}

_graft_save_map() {
  mkdir -p "$STATE_DIR"
  : > "$STATE_FILE"
  (( ${#GRAFT_ROWS} )) && print -rl -- "${GRAFT_ROWS[@]}" > "$STATE_FILE"
}

# Prints the last (active) row for $1, or nothing.
_graft_top() {
  local row top=""
  for row in "${GRAFT_ROWS[@]}"; do
    [[ "${row%%$'\t'*}" == "$1" ]] && top="$row"
  done
  print -r -- "$top"
}

# Drops rows for root $1 (only the ones for worktree $2 if given).
_graft_drop() {
  local row f kept=()
  for row in "${GRAFT_ROWS[@]}"; do
    f=("${(@ps:\t:)row}")
    [[ "${f[1]}" == "$1" && ( -z "${2:-}" || "${f[2]}" == "$2" ) ]] || kept+=("$row")
  done
  GRAFT_ROWS=("${kept[@]}")
}

_graft_prune_dead() {
  local row f
  for row in "${GRAFT_ROWS[@]}"; do
    f=("${(@ps:\t:)row}")
    [[ "${f[3]}" == "-" ]] && continue
    kill -0 "${f[3]}" 2>/dev/null || { _graft_drop "${f[1]}"; _graft_save_map; }
  done
}

# Kills the watcher with pid $1 and its children.
_graft_kill() {
  pkill -TERM -P "$1" 2>/dev/null
  kill -TERM "$1" 2>/dev/null
  sleep 0.3
  pkill -KILL -P "$1" 2>/dev/null
  kill -KILL "$1" 2>/dev/null
}

# Syncs $1 into $2 and starts its watcher; sets REPLY to the watcher pid.
_graft_spawn() {
  local worktree="$1" root="$2"
  mkdir -p "$LOG_DIR"
  local logfile="$LOG_DIR/$(basename "$root").log"
  _graft_sync "$worktree" "$root"
  (
    fswatch -o -l 0.5 "$worktree" 2>>"$logfile" | while read -r _; do
      _graft_sync "$worktree" "$root" 2>>"$logfile"
    done
  ) >>"$logfile" 2>&1 &
  disown
  REPLY=$!
}

_graft_resolve() {
  # Prints "$worktree\t$root" for the repo containing $PWD (or $1).
  local dir="${1:-$PWD}"
  local worktree common_dir root
  worktree=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || return 1
  common_dir=$(cd "$worktree" && git rev-parse --git-common-dir)
  [[ "$common_dir" = /* ]] || common_dir="$worktree/$common_dir"
  root=$(cd "$(dirname "$common_dir")" && pwd)
  printf '%s\t%s\n' "$worktree" "$root"
}

_graft_sync() {
  local worktree="$1" root="$2"
  rsync -a --delete --exclude='.git' --filter=':- .gitignore' "$worktree/" "$root/"
}

_graft_require() {
  local missing=0
  local name
  for name in "$@"; do
    if ! command -v "$name" >/dev/null 2>&1; then
      echo "graft: '$name' is required but not installed." >&2
      echo "  Re-run this repo's install.sh, or install it manually:" >&2
      echo "    macOS:          brew install $name" >&2
      echo "    Debian/Ubuntu:  sudo apt-get install $name" >&2
      echo "    Fedora/RHEL:    sudo dnf install $name" >&2
      echo "    Arch:           sudo pacman -S $name" >&2
      missing=1
    fi
  done
  (( missing )) && return 1
  return 0
}

_graft_stop_root() {
  local root="$1"
  _graft_load_map
  local top
  top=$(_graft_top "$root")
  if [[ -z "$top" ]]; then
    echo "graft: nothing running for $root" >&2
    return 1
  fi
  local f=("${(@ps:\t:)top}")
  local worktree="${f[2]}"
  _graft_kill "${f[3]}"
  _graft_drop "$root" "$worktree"

  # Another worktree is stacked underneath: resume mirroring it.
  local prev
  prev=$(_graft_top "$root")
  if [[ -n "$prev" ]]; then
    local pf=("${(@ps:\t:)prev}")
    _graft_drop "$root" "${pf[2]}"
    local pid
    _graft_spawn "${pf[2]}" "$root"; pid=$REPLY
    GRAFT_ROWS+=("$root"$'\t'"${pf[2]}"$'\t'"$pid")
    _graft_save_map
    echo "graft stopped for $worktree; resumed ${pf[2]}"
    return 0
  fi

  git -C "$root" checkout -- . 2>/dev/null
  git -C "$root" clean -fd >/dev/null 2>&1

  local stash_marker="graft-stash-for-"
  local stash_ref
  stash_ref=$(git -C "$root" stash list --format='%gd %s' | awk -v m="$stash_marker" 'index($0, m) { print $1; exit }')
  if [[ -n "$stash_ref" ]]; then
    if git -C "$root" stash pop "$stash_ref"; then
      echo "graft: restored stashed changes in $root"
    else
      echo "graft: failed to restore stash in $root — resolve manually (git stash list)" >&2
    fi
  fi

  _graft_save_map
  echo "graft stopped for $root"
}

cmd_start() {
  local resolved worktree root
  local stash_root_changes=0
  local arg
  for arg in "$@"; do
    [[ "$arg" == "--stash-root-changes" ]] && stash_root_changes=1
  done

  resolved=$(_graft_resolve) || {
    echo "graft: not inside a git repository" >&2
    return 1
  }
  worktree="${resolved%%$'\t'*}"
  root="${resolved##*$'\t'}"

  if [[ "$worktree" == "$root" ]]; then
    echo "graft: already inside the root repo ($root) — nothing to mirror" >&2
    return 1
  fi

  _graft_require fswatch rsync || return 1

  _graft_load_map
  _graft_prune_dead

  local existing
  existing=$(_graft_top "$root")
  if [[ -n "$existing" ]]; then
    local ef=("${(@ps:\t:)existing}")
    if [[ "${ef[2]}" == "$worktree" ]]; then
      echo "graft: already running for $worktree"
      echo "$root"
      return 0
    fi
    # Push: pause the current top, then mirror this worktree over it.
    _graft_kill "${ef[3]}"
    _graft_drop "$root" "$worktree"
    _graft_drop "$root" "${ef[2]}"
    GRAFT_ROWS+=("$root"$'\t'"${ef[2]}"$'\t'"-")
    local pid
    _graft_spawn "$worktree" "$root"; pid=$REPLY
    GRAFT_ROWS+=("$root"$'\t'"$worktree"$'\t'"$pid")
    _graft_save_map
    echo "graft running from the worktree $worktree (paused ${ef[2]})"
    echo "$root"
    return 0
  fi

  if [[ -n "$(git -C "$root" status --porcelain)" ]]; then
    echo "graft: $root has uncommitted changes." >&2
    if (( ! stash_root_changes )); then
      if [[ ! -t 0 ]]; then
        # No controlling terminal to prompt on (e.g. invoked by a non-
        # interactive caller like worktree-studio) — refuse rather than
        # block forever on a read() that will never get input, or worse,
        # silently treat EOF-on-stdin as an implicit "no". Callers that
        # want the old prompt's "yes" behavior non-interactively should
        # pass --stash-root-changes explicitly.
        echo "graft: refusing to prompt without a terminal — re-run with --stash-root-changes to stash and start non-interactively, or commit/stash the changes in $root yourself first" >&2
        return 1
      fi
      local reply
      read -r "reply?Stash them and start graft? [y/N] "
      if [[ ! "$reply" =~ ^[Yy]$ ]]; then
        echo "graft: aborted — commit or stash the changes in $root first" >&2
        return 1
      fi
    fi
    if ! git -C "$root" stash push --include-untracked --message "graft-stash-for-$worktree" >&2; then
      echo "graft: failed to stash changes in $root" >&2
      return 1
    fi
    echo "graft: stashed uncommitted changes in $root" >&2
  fi

  local pid
  _graft_spawn "$worktree" "$root"; pid=$REPLY
  GRAFT_ROWS+=("$root"$'\t'"$worktree"$'\t'"$pid")
  _graft_save_map

  echo "graft running from the worktree $worktree"
  echo "$root"
}

cmd_stop() {
  local root="$1"
  if [[ -z "$root" ]]; then
    local resolved
    resolved=$(_graft_resolve) || {
      echo "graft: not inside a git repository; pass a root path or run 'graft list'" >&2
      return 1
    }
    root="${resolved##*$'\t'}"
  else
    root=$(cd "$root" 2>/dev/null && pwd) || {
      echo "graft: no such directory: $1" >&2
      return 1
    }
  fi
  _graft_stop_root "$root"
}

cmd_list() {
  _graft_load_map
  _graft_prune_dead
  if (( ${#GRAFT_ROWS} == 0 )); then
    echo "no graft instances running"
    return 0
  fi
  local row f
  for row in "${GRAFT_ROWS[@]}"; do
    f=("${(@ps:\t:)row}")
    if [[ "${f[3]}" == "-" ]]; then
      printf '%s  <-  %s  (paused)\n' "${f[1]}" "${f[2]}"
    else
      printf '%s  <-  %s  (pid %s)\n' "${f[1]}" "${f[2]}" "${f[3]}"
    fi
  done
}

cmd_help() {
  cat <<'EOF'
graft — mirror a git worktree into its repo's root checkout

Usage:
  graft start [--stash-root-changes]
                             Mirror the current worktree into its root repo
                             --stash-root-changes: stash uncommitted root changes
                             without prompting (needed when not on a terminal);
                             'stop' restores them
  graft stop [root]      Stop the active mirror and resume the previous
                         worktree, if any (defaults to the current repo)
  graft list             List all graft instances (paused ones are stacked)
EOF
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  stop)  shift; cmd_stop "$@" ;;
  list)  shift; cmd_list "$@" ;;
  help|-h|--help|"") cmd_help ;;
  *) echo "graft: unknown command '$1'" >&2; cmd_help; exit 1 ;;
esac
